import os
import joblib
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras.applications import MobileNetV2
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Dense, GlobalAveragePooling2D, Dropout
from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint
from datetime import datetime


# ✅ CONFIG
CONFIG = {
    "dataset_path": "dataset",
    "image_size": (224, 224),
    "batch_size": 32,
    "epochs": 15,
    "model_h5": "models/skin_disease_model.h5",
    "labels_pkl": "models/class_indices.pkl",
    "plot_path": "models/training_plot.png"
}


def setup_gpu():
    gpus = tf.config.list_physical_devices('GPU')
    if gpus:
        try:
            for gpu in gpus:
                tf.config.experimental.set_memory_growth(gpu, True)
            print(f"✅ GPU Detected: {gpus[0].name}")
        except RuntimeError as e:
            print(f"⚠️ Error setting memory growth: {e}")
    else:
        print("⚠️ No GPU found. Using CPU...")


def get_data_generators():
    datagen = ImageDataGenerator(
        rescale=1./255,
        validation_split=0.2,
        rotation_range=30,
        zoom_range=0.2,
        horizontal_flip=True
    )

    train_gen = datagen.flow_from_directory(
        CONFIG["dataset_path"],
        target_size=CONFIG["image_size"],
        batch_size=CONFIG["batch_size"],
        class_mode="categorical",
        subset="training",
        shuffle=True
    )

    val_gen = datagen.flow_from_directory(
        CONFIG["dataset_path"],
        target_size=CONFIG["image_size"],
        batch_size=CONFIG["batch_size"],
        class_mode="categorical",
        subset="validation"
    )

    return train_gen, val_gen


def build_model(num_classes):
    base = MobileNetV2(include_top=False, weights='imagenet', input_shape=(224, 224, 3))
    base.trainable = False

    x = GlobalAveragePooling2D()(base.output)
    x = Dropout(0.5)(x)
    output = Dense(num_classes, activation='softmax')(x)

    model = Model(inputs=base.input, outputs=output)
    model.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])

    return model


def plot_history(history, plot_path):
    plt.figure(figsize=(8, 5))
    plt.plot(history.history['accuracy'], label='Train Accuracy', marker='o')
    plt.plot(history.history['val_accuracy'], label='Val Accuracy', marker='x')
    plt.title("Training Accuracy over Epochs")
    plt.xlabel("Epoch")
    plt.ylabel("Accuracy")
    plt.legend()
    plt.grid(True)
    plt.savefig(plot_path)
    plt.close()
    print(f"📈 Training plot saved to {plot_path}")


def train_and_save():
    os.makedirs("models", exist_ok=True)
    setup_gpu()

    print(f"📂 Loading data from: {CONFIG['dataset_path']}")
    train_gen, val_gen = get_data_generators()
    num_classes = len(train_gen.class_indices)

    print(f"🧠 Building model for {num_classes} classes...")
    model = build_model(num_classes)

    callbacks = [
        EarlyStopping(monitor="val_loss", patience=3, restore_best_weights=True),
        ModelCheckpoint(CONFIG["model_h5"], save_best_only=True)
    ]

    print("🏋️ Training model...")
    history = model.fit(
        train_gen,
        validation_data=val_gen,
        epochs=CONFIG["epochs"],
        callbacks=callbacks
    )

    print(f"💾 Saving model to {CONFIG['model_h5']}")
    model.save(CONFIG["model_h5"])

    print(f"🗂️ Saving class indices to {CONFIG['labels_pkl']}")
    joblib.dump(train_gen.class_indices, CONFIG["labels_pkl"])

    plot_history(history, CONFIG["plot_path"])
    print("✅ Training complete!")


if __name__ == "__main__":
    print(f"🚀 Started Training @ {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    train_and_save()
